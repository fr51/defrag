<Window x:Name="settingsWindow" x:Class="defrag.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:defrag" mc:Ignorable="d" Height="300" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#FFFFFF9F" Loaded="SettingsWindow_Loaded" ContentRendered="SettingsWindow_ContentRendered" xmlns:vc="clr-namespace:WPFUpDownControl;assembly=WPFUpDownControl">
	<Grid x:Name="SettingsWindowGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<TextBlock x:Name="messageToUserIntervalLabel" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="Auto" Width="Auto" TextWrapping="Wrap"/>
		<vc:UpDownControl x:Name="messageToUserIntervalUpDownControl" Grid.Column="1" Grid.Row="0" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=messageToUserIntervalLabel}" VerticalAlignment="{Binding VerticalAlignment, ElementName=messageToUserIntervalLabel}" Height="{Binding Height, ElementName=messageToUserIntervalLabel}" Width="100" CurrentValue="5" Step="1" MinValue="1" MaxValue="5" ButtonsOnly="True"/>
		<Label x:Name="LanguageSelectionLabel" Grid.Column="0" Grid.Row="1" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=messageToUserIntervalLabel}" VerticalAlignment="{Binding VerticalAlignment, ElementName=messageToUserIntervalLabel}" Height="{Binding Height, ElementName=messageToUserIntervalLabel}" Width="{Binding Width, ElementName=messageToUserIntervalLabel}"/>
		<ComboBox x:Name="LanguageSelectionList" Grid.Column="1" Grid.Row="1" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=messageToUserIntervalLabel}" VerticalAlignment="{Binding VerticalAlignment, ElementName=messageToUserIntervalLabel}" Height="{Binding Height, ElementName=messageToUserIntervalLabel}" Width="{Binding Width, ElementName=messageToUserIntervalLabel}">
			<ComboBoxItem x:Name="fr" Content="Français" IsSelected="True"/>
			<ComboBoxItem x:Name="en" Content="English"/>
		</ComboBox>
		<Button x:Name="SettingsWindowOKButton" Grid.Column="0" Grid.Row="2" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=messageToUserIntervalLabel}" VerticalAlignment="{Binding VerticalAlignment, ElementName=messageToUserIntervalLabel}" Height="20" Width="40" Click="SettingsWindowOKButton_Click"/>
		<Button x:Name="SettingsWindowCancelButton" Grid.Column="1" Grid.Row="2" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=messageToUserIntervalLabel}" VerticalAlignment="{Binding VerticalAlignment, ElementName=messageToUserIntervalLabel}" Height="{Binding Height, ElementName=SettingsWindowOKButton}" Width="Auto" Click="SettingsWindowCancelButton_Click"/>
	</Grid>
</Window>